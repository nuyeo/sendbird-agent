# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_api_key_here

# PostgreSQL
POSTGRES_URL=postgresql+psycopg://cs_agent:cs_agent_pw@localhost:5432/cs_agent

# Redis
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400

# JWT (WebSocket 인증)
# 32바이트 이상 무작위 문자열 권장: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=60

# 동시 LLM 호출 제한 (단일 워커 기준)
MAX_CONCURRENT_LLM=50

# LLM 호출 신뢰성 (단일 요청 단위)
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# Rate limiting (REST 엔드포인트). slowapi 표기법 사용 (예: "10/minute")
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEV_TOKEN=10/minute
RATE_LIMIT_LOGS_READ=60/minute
RATE_LIMIT_LOGS_FEEDBACK=30/minute

# /metrics 엔드포인트 보호용 bearer token. 비워두면 가드 비활성화 (운영 환경에서는
# ingress/LB로 차단하거나 토큰을 설정해 telemetry 노출을 막는 것을 권장).
METRICS_BEARER_TOKEN=

# Server
DEBUG=false
