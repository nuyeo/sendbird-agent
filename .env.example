# Sendbird Configuration (Phase B에서 제거 예정)
SENDBIRD_APP_ID=your_sendbird_app_id_here
SENDBIRD_API_TOKEN=your_sendbird_api_token_here

# OpenAI Configuration
OPENAI_API_KEY=sk-your_openai_api_key_here

# PostgreSQL (Phase A)
POSTGRES_URL=postgresql+psycopg://cs_agent:cs_agent_pw@localhost:5432/cs_agent

# Redis (Phase A)
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=86400

# JWT (Phase B WebSocket 인증)
# 32바이트 이상 무작위 문자열 권장: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_EXPIRE_MINUTES=60

# 동시 LLM 호출 제한 (단일 워커 기준)
MAX_CONCURRENT_LLM=50

# Server
DEBUG=false
